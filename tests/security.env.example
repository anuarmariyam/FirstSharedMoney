# Copy to the ignored root file .env.security.local.
# Only use a separate disposable Supabase test project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FSM_TEST_PROJECT_REF=
FSM_TEST_DATABASE_URL=
# Optional project CA certificate path if required for verified database TLS.
FSM_TEST_DATABASE_CA_FILE=
FSM_TEST_APP_ORIGIN=http://127.0.0.1:5173
# Set to 1 only after reviewing the test's targeted creation/cleanup behavior.
FSM_ALLOW_TEST_DATABASE_MUTATIONS=
